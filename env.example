# ========================================
# CONFIGURAÇÕES DO JUKEBOX-PI-MONEY
# Sistema Multi-Pagamento
# ========================================

# === HARDWARE (ACEITADOR DE NOTAS) ===
HARDWARE_ENABLED=true
GPIO_BILL_ACCEPTOR=17
PULSE_VALUE=2.00
DEBOUNCE_MS=200

# === GATEWAY DE PAGAMENTO ===
PAYMENT_DIGITAL_ENABLED=true

# Provedor (mercadopago, stone, pagseguro)
PAYMENT_PROVIDER=mercadopago

# Credenciais (OBTENHA NO PAINEL DO PROVEDOR!)
PAYMENT_API_KEY=YOUR_API_KEY_HERE
PAYMENT_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE

# URL pública para receber webhooks (use ngrok para testes)
PAYMENT_WEBHOOK_URL=https://seu-dominio.com/api/webhook

# Timeout de requisições
PAYMENT_TIMEOUT=30

# === NEGÓCIO ===
# Preço base por música
PRICE_PER_SONG=5.00

# Taxas por método de pagamento (percentual)
CREDIT_CARD_FEE=3.99   # 3.99% para crédito
DEBIT_CARD_FEE=1.99    # 1.99% para débito
PIX_FEE=0.00           # Sem taxa para PIX
CASH_FEE=0.00          # Sem taxa para dinheiro

# Métodos habilitados (separados por vírgula)
ENABLED_PAYMENT_METHODS=cash,debit,credit,pix

# Limite de músicas na fila
MAX_QUEUE_SIZE=10

# Timeout de inatividade (segundos)
IDLE_TIMEOUT=300

# === FLASK ===
FLASK_ENV=production
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_RANDOM_STRING
HARDWARE_TOKEN=GENERATE_RANDOM_TOKEN_FOR_HARDWARE
WEBHOOK_SECRET=GENERATE_RANDOM_TOKEN_FOR_WEBHOOKS
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
CORS_ORIGINS=*

# === YOUTUBE ===
CHROME_DRIVER_PATH=/usr/bin/chromedriver
YOUTUBE_AUTOPLAY=true
SELENIUM_TIMEOUT=10
CHROME_USER_AGENT=Mozilla/5.0 (X11; Linux armv7l) AppleWebKit/537.36

# === DATABASE ===
DB_PATH=src/db/jukebox.db

# === LOGS ===
LOG_LEVEL=INFO
LOG_FILE=logs/jukebox.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

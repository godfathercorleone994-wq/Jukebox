# ========================================
# CONFIGURAÇÕES DO JUKEBOX-PI-MONEY
# Copie para .env e ajuste os valores
# ========================================

# === HARDWARE ===
# Pino GPIO conectado ao aceitador de notas
GPIO_BILL_ACCEPTOR=17

# Valor em reais de cada pulso recebido
PULSE_VALUE=2.00

# Debounce em milissegundos (evitar ruído)
DEBOUNCE_MS=200

# === NEGÓCIO ===
# Preço cobrado por música
PRICE_PER_SONG=5.00

# Máximo de músicas na fila
MAX_QUEUE_SIZE=10

# Timeout de inatividade em segundos
IDLE_TIMEOUT=300

# === FLASK ===
# Ambiente (development ou production)
FLASK_ENV=production

# Chave secreta (GERE UMA ALEATÓRIA!)
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION

# Token para hardware (GERE UM ALEATÓRIO!)
HARDWARE_TOKEN=GENERATE_RANDOM_TOKEN

# Porta do servidor web
FLASK_PORT=5000

# Host (0.0.0.0 = aceita conexões externas)
FLASK_HOST=0.0.0.0

# === YOUTUBE ===
# Caminho do ChromeDriver
CHROME_DRIVER_PATH=/usr/bin/chromedriver

# Ativar autoplay (true/false)
YOUTUBE_AUTOPLAY=true

# Timeout do Selenium em segundos
SELENIUM_TIMEOUT=10

# === DATABASE ===
# Caminho do banco SQLite
DB_PATH=src/db/jukebox.db

# === LOGS ===
# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Arquivo de log
LOG_FILE=logs/jukebox.log
